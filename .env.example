# Copy to .env.local and fill in. See docs/security.md §3 for the full
# classification (what's public vs server-only and why).

# --- Supabase (public — safe once RLS is on) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-dev-only bypass: swaps the sign-in form to email+password instead of
# a magic link (Supabase's redirect URL is pinned to the production domain,
# so magic-link emails don't route back to localhost). Set to "true" here;
# leave UNSET in the Vercel project so production always uses magic link.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# --- Supabase (server-only; bypasses RLS — see docs/technical-decisions.md ADR-014 addendum) ---
SUPABASE_SECRET_KEY=

# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Only used by scripts/run-migrations.ts; never imported by the app.
DATABASE_URL=

# --- Gemini (server-only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Qdrant (server-only) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=retriva
